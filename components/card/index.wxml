<view class="home-card">
  <!-- 头图（有图片时显示） -->
  <view class="home-card__image-wrap" wx:if="{{url}}">
    <t-image t-class="home-card__image" src="{{url}}" mode="aspectFill" />
    <!-- 匹名标记 -->
    <view class="anonymous-badge" wx:if="{{isAnonymous}}">
      <t-icon name="user-avatar" size="18rpx" color="rgba(255,255,255,0.8)" />
    </view>
  </view>

  <!-- 卡片内容 -->
  <view class="home-card__body">
    <!-- 作者头像区（无图片时显示在顶部） -->
    <view class="home-card__author" wx:if="{{!url}}">
      <view class="author-avatar {{isAnonymous ? 'avatar-anonymous' : ''}}">
        <image wx:if="{{avatar && !isAnonymous}}" src="{{avatar}}" mode="aspectFill" />
        <t-icon wx:else name="user-avatar" size="28rpx" color="{{isAnonymous ? '#9ca3af' : '#7c3aed'}}" />
      </view>
      <view class="author-name-wrap">
        <text class="author-name">{{isAnonymous ? '匿名的你' : nickname}}</text>
        <text class="author-dept" wx:if="{{!isAnonymous && department}}">{{department}}</text>
      </view>
      <view class="teacher-tag" wx:if="{{role === 'teacher'}}">
        <t-icon name="education" size="18rpx" />
        <text>教师</text>
      </view>
    </view>

    <!-- 正文 -->
    <text class="home-card__desc">{{desc}}</text>

    <!-- 标签 -->
    <view class="home-card__tag-group" wx:if="{{tags && tags.length > 0}}">
      <t-tag wx:for="{{tags}}" wx:key="index" size="small" variant="light" theme="{{item.theme}}">{{item.text}}</t-tag>
    </view>

    <!-- 底部：有图时展示作者信息 + 点赞 -->
    <view class="home-card__footer" wx:if="{{url}}">
      <view class="footer-author">
        <view class="footer-avatar {{isAnonymous ? 'avatar-anonymous' : ''}}">
          <image wx:if="{{avatar && !isAnonymous}}" src="{{avatar}}" mode="aspectFill" />
          <t-icon wx:else name="user-avatar" size="20rpx" color="{{isAnonymous ? '#9ca3af' : '#7c3aed'}}" />
        </view>
        <text class="footer-name">{{isAnonymous ? '匿名' : nickname}}</text>
        <view class="teacher-tag-small" wx:if="{{role === 'teacher'}}">
          <t-icon name="education" size="16rpx" />
        </view>
      </view>
      <view class="footer-like">
        <t-icon name="thumb-up" size="26rpx" color="#9ca3af" />
        <text class="like-count">{{likeCount}}</text>
      </view>
    </view>

    <!-- 无图时的底部：时间 + 点赞 -->
    <view class="home-card__footer-plain" wx:else>
      <view class="footer-like-plain">
        <t-icon name="thumb-up" size="26rpx" color="#9ca3af" />
        <text class="like-count">{{likeCount}}</text>
      </view>
      <text class="footer-time">{{createdAt}}</text>
    </view>
  </view>
</view>
