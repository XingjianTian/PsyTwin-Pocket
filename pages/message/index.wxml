<view class="message-container">
  <!-- 标题 -->
  <view class="message-header">
    <text class="header-title">AI 对话</text>
    <text class="header-subtitle">PsyTwin 时刻守护你的心理健康</text>
  </view>

  <!-- 会话列表 -->
  <scroll-view 
    class="session-list" 
    scroll-y
    refresher-enabled
    refresher-triggered="{{ loading }}"
    bindrefresherrefresh="loadSessions"
  >
    <block wx:if="{{sessions.length > 0}}">
      <view 
        class="session-item" 
        wx:for="{{sessions}}" 
        wx:key="id"
        bindtap="toChat" 
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        data-name="{{item.name}}"
      >
        <!-- 头像 -->
        <view class="session-avatar">
          <image src="{{item.avatar}}" mode="aspectFill" />
          <view class="status-dot" wx:if="{{item.status === 'online'}}"></view>
        </view>

        <!-- 信息 -->
        <view class="session-info">
          <view class="session-header">
            <text class="session-name">{{item.name}}</text>
            <text class="session-time">{{item.lastMessageTime}}</text>
          </view>
          <view class="session-desc">
            <text class="session-type">
              {{item.type === 'ai' ? 'AI助手' : '咨询师'}}
            </text>
            <text class="session-last-msg">{{item.lastMessage}}</text>
          </view>
        </view>

        <!-- 未读角标 -->
        <view class="unread-badge" wx:if="{{item.unreadCount > 0}}">
          {{item.unreadCount > 99 ? '99+' : item.unreadCount}}
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-state">
        <text class="empty-icon">💬</text>
        <text class="empty-text">暂无会话</text>
        <text class="empty-hint">可以开始和 AI 助手聊天啦</text>
      </view>
    </block>
  </scroll-view>
</view>
