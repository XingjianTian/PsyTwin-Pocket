<view class="my-page">
  <!-- 顶部背景 -->
  <view class="my-header">
    <view class="header-bg"></view>
    
    <!-- 用户信息 -->
    <view class="user-info" wx:if="{{isLoad}}">
      <view class="user-avatar" bindtap="onEditProfile">
        <image 
          src="{{userInfo.avatar || '/static/img_td.png'}}" 
          mode="aspectFill" 
        />
        <view class="edit-icon">✏️</view>
      </view>
      <view class="user-detail">
        <view class="user-name">
          {{userInfo.nickname || '用户'}}
          <text class="role-badge" wx:if="{{role === 'teacher'}}">教师</text>
        </view>
        <view class="user-meta" wx:if="{{userInfo.studentId}}">
          学号：{{userInfo.studentId}}
        </view>
      </view>
    </view>

    <!-- 未登录 -->
    <view class="user-info" wx:else bindtap="goLogin">
      <view class="user-avatar">
        <image src="/static/img_td.png" mode="aspectFill" />
      </view>
      <view class="user-detail">
        <view class="user-name">点击登录</view>
      </view>
    </view>
  </view>

  <!-- 功能宫格 -->
  <view class="grid-section">
    <view class="grid-list">
      <view 
        class="grid-item" 
        wx:for="{{gridList}}" 
        wx:key="name"
        bindtap="onGridTap" 
        data-url="{{item.url}}"
      >
        <text class="grid-icon">{{item.icon}}</text>
        <text class="grid-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view 
      class="menu-item" 
      wx:for="{{menuList}}" 
      wx:key="name"
      bindtap="onMenuTap" 
      data-url="{{item.url}}"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
      </view>
      <view class="menu-arrow">→</view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoad}}">
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>
</view>
