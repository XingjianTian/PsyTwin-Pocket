<t-navbar title="工作台" />

<view class="workbench">
  <!-- 预警统计卡片 -->
  <view class="warning-stats-card">
    <view class="warning-stats-header">
      <text class="warning-stats-title">预警看板</text>
      <view class="warning-stats-filter">
        <text class="filter-item {{warningFilter === 'all' ? 'active' : ''}}" data-level="all" bindtap="onWarningFilterChange">全部</text>
        <text class="filter-item {{warningFilter === 'high' ? 'active' : ''}}" data-level="high" bindtap="onWarningFilterChange">高风险</text>
        <text class="filter-item {{warningFilter === 'medium' ? 'active' : ''}}" data-level="medium" bindtap="onWarningFilterChange">中风险</text>
      </view>
    </view>

    <!-- 预警统计数字 -->
    <view class="warning-stats-numbers">
      <view class="stats-number-item high">
        <text class="stats-number">{{warningStats.high}}</text>
        <text class="stats-label">高风险</text>
      </view>
      <view class="stats-number-item medium">
        <text class="stats-number">{{warningStats.medium}}</text>
        <text class="stats-label">中风险</text>
      </view>
      <view class="stats-number-item low">
        <text class="stats-number">{{warningStats.low}}</text>
        <text class="stats-label">低风险</text>
      </view>
    </view>

    <!-- 预警列表（横向滚动） -->
    <scroll-view class="warning-list-scroll" scroll-x enable-flex>
      <view class="warning-list">
        <view
          class="warning-item {{item.riskLevel}}"
          wx:for="{{warningList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onWarningTap"
        >
          <image class="warning-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="warning-info">
            <text class="warning-name">{{item.studentName}}</text>
            <text class="warning-reason">{{item.riskReason}}</text>
          </view>
          <view class="warning-badge {{item.riskLevel}}">{{item.riskLevel === 'high' ? '高' : item.riskLevel === 'medium' ? '中' : '低'}}</view>
        </view>
      </view>
    </scroll-view>

    <!-- 查看更多 -->
    <view class="view-more" bindtap="onViewAllWarnings">
      <text>查看全部预警</text>
      <t-icon name="chevron-right" size="32rpx" />
    </view>
  </view>

  <!-- 今日日程 -->
  <view class="schedule-card">
    <view class="schedule-header" bindtap="onToggleSchedule">
      <view class="schedule-title-section">
        <text class="schedule-title">今日日程</text>
        <view class="schedule-stats">
          <text class="schedule-stat completed">已完成 {{scheduleStats.completed}}</text>
          <text class="schedule-stat upcoming">待进行 {{scheduleStats.upcoming}}</text>
          <text wx:if="{{scheduleStats.ongoing > 0}}" class="schedule-stat ongoing">进行中 {{scheduleStats.ongoing}}</text>
        </view>
      </view>
      <t-icon name="{{scheduleExpanded ? 'chevron-up' : 'chevron-down'}}" size="40rpx" color="rgba(0,0,0,0.4)" />
    </view>

    <!-- 日程列表 -->
    <view class="schedule-list" wx:if="{{scheduleExpanded || scheduleList.length <= 2}}">
      <view
        class="schedule-item {{item.status}}"
        wx:for="{{scheduleList}}"
        wx:key="id"
        data-item="{{item}}"
        bindtap="onScheduleTap"
      >
        <view class="schedule-time">
          <text class="time-start">{{item.startTime}}</text>
          <text class="time-end">{{item.endTime}}</text>
        </view>
        <view class="schedule-divider">
          <view class="schedule-dot {{item.status}}" />
          <view class="schedule-line" wx:if="{{index < scheduleList.length - 1}}" />
        </view>
        <view class="schedule-content">
          <view class="schedule-type-row">
            <text class="schedule-type">{{item.type === 'counseling' ? '心理咨询' : '值班'}}</text>
            <text class="schedule-status">{{item.status === 'completed' ? '已完成' : item.status === 'ongoing' ? '进行中' : '待进行'}}</text>
          </view>
          <view class="schedule-detail" wx:if="{{item.studentName}}">
            <image class="schedule-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <text class="schedule-student">{{item.studentName}}</text>
          </view>
          <text class="schedule-location">📍 {{item.location}}</text>
          <text wx:if="{{item.notes}}" class="schedule-notes">{{item.notes}}</text>
        </view>
      </view>
    </view>

    <!-- 折叠提示 -->
    <view class="schedule-collapsed-hint" wx:if="{{!scheduleExpanded && scheduleList.length > 2}}" bindtap="onToggleSchedule">
      <text>还有 {{scheduleList.length - 2}} 个日程</text>
      <t-icon name="chevron-down" size="28rpx" />
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-entry-card">
    <text class="quick-entry-title">快捷入口</text>
    <view class="quick-entry-grid">
      <view
        class="quick-entry-item"
        wx:for="{{quickEntries}}"
        wx:key="name"
        data-url="{{item.url}}"
        data-name="{{item.name}}"
        bindtap="onQuickEntryTap"
      >
        <view class="quick-entry-icon" style="background-color: {{item.color}}20;">
          <t-icon name="{{item.icon}}" size="48rpx" color="{{item.color}}" />
        </view>
        <text class="quick-entry-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 工作统计 -->
  <view class="work-stats-card">
    <text class="work-stats-title">本月工作统计</text>
    <view class="work-stats-grid">
      <view class="work-stats-item">
        <text class="work-stats-number">{{workStats.thisMonthCounseling}}</text>
        <text class="work-stats-label">本月咨询</text>
        <view class="work-stats-trend {{workStats.thisMonthCounselingTrend >= 0 ? 'up' : 'down'}}">
          <t-icon name="{{workStats.thisMonthCounselingTrend >= 0 ? 'arrow-up' : 'arrow-down'}}" size="20rpx" />
          <text>{{Math.abs(workStats.thisMonthCounselingTrend)}}%</text>
        </view>
      </view>
      <view class="work-stats-item">
        <text class="work-stats-number">{{workStats.totalHours}}</text>
        <text class="work-stats-label">累计时长(小时)</text>
        <view class="work-stats-trend {{workStats.totalHoursTrend >= 0 ? 'up' : 'down'}}">
          <t-icon name="{{workStats.totalHoursTrend >= 0 ? 'arrow-up' : 'arrow-down'}}" size="20rpx" />
          <text>{{Math.abs(workStats.totalHoursTrend)}}%</text>
        </view>
      </view>
      <view class="work-stats-item">
        <text class="work-stats-number">{{workStats.resolvedWarnings}}</text>
        <text class="work-stats-label">处理预警</text>
        <view class="work-stats-trend {{workStats.resolvedWarningsTrend >= 0 ? 'up' : 'down'}}">
          <t-icon name="{{workStats.resolvedWarningsTrend >= 0 ? 'arrow-up' : 'arrow-down'}}" size="20rpx" />
          <text>{{Math.abs(workStats.resolvedWarningsTrend)}}%</text>
        </view>
      </view>
      <view class="work-stats-item">
        <text class="work-stats-number">{{workStats.satisfactionRate}}</text>
        <text class="work-stats-label">满意度</text>
        <view class="work-stats-trend {{workStats.satisfactionRateTrend >= 0 ? 'up' : 'down'}}">
          <t-icon name="{{workStats.satisfactionRateTrend >= 0 ? 'arrow-up' : 'arrow-down'}}" size="20rpx" />
          <text>{{workStats.satisfactionRateTrend > 0 ? '+' : ''}}{{workStats.satisfactionRateTrend}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-padding" />
</view>
