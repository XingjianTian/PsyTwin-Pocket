<view class="post-detail-container">
  <!-- 动态详情内容 -->
  <block wx:if="{{postDetail}}">
    <view class="post-content">
    <!-- 头部信息 -->
    <view class="post-header">
      <view class="author-info">
        <view class="author-avatar {{postDetail.content.isAnonymous ? 'avatar-anonymous' : ''}}">
          <image wx:if="{{postDetail.author.avatar && !postDetail.content.isAnonymous}}" src="{{postDetail.author.avatar}}" mode="aspectFill" />
          <t-icon wx:else name="user-avatar" size="40rpx" color="{{postDetail.content.isAnonymous ? '#9ca3af' : '#7c3aed'}}" />
        </view>
        <view class="author-meta">
          <view class="author-name-row">
            <text class="author-name">{{postDetail.content.isAnonymous ? '匿名的你' : postDetail.author.nickname}}</text>
            <view class="teacher-tag" wx:if="{{postDetail.author.role === 'teacher'}}">
              <t-icon name="education" size="24rpx" />
              <text>教师</text>
            </view>
          </view>
          <view class="author-sub">
            <text class="author-dept" wx:if="{{!postDetail.content.isAnonymous && postDetail.author.department}}">{{postDetail.author.department}}</text>
            <text class="post-time">{{postDetail.createdAt}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 正文内容 -->
    <view class="post-body">
      <text class="post-text" user-select>{{postDetail.content.text}}</text>
      
      <!-- 位置标签 -->
      <view class="location-tag" wx:if="{{postDetail.content.location}}">
        <t-icon name="location" size="24rpx" />
        <text>{{postDetail.content.location}}</text>
      </view>

      <!-- 图片网格 -->
      <view class="image-grid" wx:if="{{postDetail.content.images && postDetail.content.images.length > 0}}">
        <image 
          wx:for="{{postDetail.content.images}}" 
          wx:key="*this"
          src="{{item}}" 
          mode="aspectFill" 
          class="post-image {{postDetail.content.images.length === 1 ? 'single' : ''}}"
          bindtap="previewImage" 
          data-index="{{index}}" 
        />
      </view>
    </view>

    <!-- 互动数据 -->
    <view class="post-stats">
      <view class="stats-left">
        <text>{{likeCount}} 赞 · {{postDetail.stats.commentCount}} 评论</text>
      </view>
      <view class="action-btns">
        <view class="action-btn {{isLiked ? 'liked' : ''}}" bindtap="onLikeTap">
          <t-icon name="thumb-up" size="36rpx" color="{{isLiked ? '#7c3aed' : '#9ca3af'}}" />
        </view>
        <view class="action-btn">
          <t-icon name="star" size="36rpx" color="{{isCollected ? '#7c3aed' : '#9ca3af'}}" />
        </view>
        <button class="share-btn" open-type="share">
          <t-icon name="share" size="36rpx" color="#9ca3af" />
        </button>
      </view>
    </view>
    <view class="post-stats">
      <text>{{postDetail.stats.likeCount}} 赞 · {{postDetail.stats.commentCount}} 评论</text>
    </view>
    </view>

    <!-- 评论区 -->
    <view class="comments-section" wx:if="{{comments.length > 0}}">
      <view class="comments-header">评论 ({{comments.length}})</view>
      
      <view class="comment-list">
        <view wx:for="{{comments}}" wx:key="id" class="comment-item">
          <view class="comment-avatar {{item.author.role === 'teacher' ? 'teacher-avatar' : ''}}">
            <image wx:if="{{item.author.avatar}}" src="{{item.author.avatar}}" mode="aspectFill" />
            <t-icon wx:else name="user-avatar" size="32rpx" color="#7c3aed" />
          </view>
          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-author">{{item.author.nickname}}</text>
              <view class="teacher-badge" wx:if="{{item.author.role === 'teacher'}}">教师</view>
              <text class="comment-time">{{item.createdAt}}</text>
            </view>
            <text class="comment-content">{{item.content}}</text>
            <view class="comment-actions">
              <view class="comment-like">
                <t-icon name="thumb-up" size="24rpx" color="{{item.isLiked ? '#7c3aed' : '#9ca3af'}}" />
                <text>{{item.likeCount}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="comments-empty" wx:else>
      <t-icon name="chat" size="64rpx" color="#ccc" />
      <text>暂无评论，快来抢沙发吧~</text>
    </view>
  </block>

  <!-- 加载状态 -->
  <view class="loading-state" wx:elif="{{isLoading}}">
    <t-loading theme="circular" size="40rpx" text="加载中..." />
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <t-empty icon="info-circle-filled" description="暂无内容" />
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <t-input
      class="comment-input"
      placeholder="说点什么吧..."
      value="{{inputValue}}"
      bindchange="onInputChange"
    />
    <t-button theme="primary" size="small" bindtap="onSendComment">发送</t-button>
  </view>
</view>
