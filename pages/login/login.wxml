<t-navbar left-arrow />
<view class="page login">
  <view class="login__title"> 欢迎登录 </view>
  <view class="login__subtitle">PsyTwin 校园心理健康平台</view>

  <view class="login__content">
    <!-- 手机号输入 -->
    <view class="login__input">
      <t-input
        value="{{phoneNumber}}"
        placeholder="请输入手机号"
        type="number"
        bindchange="onPhoneInput"
      >
        <view slot="label" class="input-label">
          <text>+86</text>
          <t-icon name="caret-down-small" size="40rpx" class="input-iconl"></t-icon>
        </view>
      </t-input>
    </view>

    <!-- 密码输入 -->
    <view class="login__input">
      <t-input
        value="{{password}}"
        placeholder="请输入密码"
        type="text"
        bindchange="onPasswordInput"
      >
        <view slot="label" class="input-label">
          <text>密码</text>
        </view>
      </t-input>
    </view>

    <!-- 身份选择按钮 -->
    <view class="login__role-buttons">
      <view class="login__role-label">请选择身份</view>
      <view class="login__role-row">
        <t-button
          class="role-btn {{selectedRole === 'student' ? 'active' : ''}}"
          variant="{{selectedRole === 'student' ? 'primary' : 'outline'}}"
          block
          bindtap="onSelectRole"
          data-role="student"
        >
          学生
        </t-button>
        <t-button
          class="role-btn {{selectedRole === 'teacher' ? 'active' : ''}}"
          variant="{{selectedRole === 'teacher' ? 'primary' : 'outline'}}"
          block
          bindtap="onSelectRole"
          data-role="teacher"
        >
          教职工
        </t-button>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="login__button">
      <t-button
        theme="primary"
        size="large"
        block
        disabled="{{!phoneNumber || !password || !selectedRole}}"
        bindtap="login"
      >
        登录
      </t-button>
    </view>
  </view>
</view>
