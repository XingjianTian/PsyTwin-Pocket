<view class="pet-container {{isFullscreen ? 'fullscreen' : ''}}">
  <!-- 状态栏 -->
  <view class="status-bar">
    <view class="status-card">
      <!-- 心情 -->
      <view class="status-item">
        <view class="status-icon-wrapper">
          <text class="status-icon {{mood < 30 ? 'warning' : ''}}">❤️</text>
        </view>
        <text class="status-label">心情</text>
        <view class="progress-wrapper">
          <view class="progress-track">
            <view class="progress-fill mood-fill" style="width: {{mood}}%"></view>
          </view>
        </view>
        <text class="status-value {{mood < 30 ? 'warning-text' : ''}}">{{mood}}</text>
      </view>

      <!-- 能量 -->
      <view class="status-item">
        <view class="status-icon-wrapper">
          <text class="status-icon {{energy < 30 ? 'warning' : ''}}">⚡</text>
        </view>
        <text class="status-label">能量</text>
        <view class="progress-wrapper">
          <view class="progress-track">
            <view class="progress-fill energy-fill" style="width: {{energy}}%"></view>
          </view>
        </view>
        <text class="status-value {{energy < 30 ? 'warning-text' : ''}}">{{energy}}</text>
      </view>

      <!-- 社交 -->
      <view class="status-item">
        <view class="status-icon-wrapper">
          <text class="status-icon {{social < 30 ? 'warning' : ''}}">👥</text>
        </view>
        <text class="status-label">社交</text>
        <view class="progress-wrapper">
          <view class="progress-track">
            <view class="progress-fill social-fill" style="width: {{social}}%"></view>
          </view>
        </view>
        <text class="status-value {{social < 30 ? 'warning-text' : ''}}">{{social}}</text>
      </view>
    </view>

    <!-- 右侧按钮组 -->
    <view class="status-actions">
      <view class="action-btn settings-btn" bindtap="{{currentView === 'game' ? 'onSettingsTap' : 'backToGame'}}">
        <text class="action-icon">{{currentView === 'game' ? '⚙️' : '✕'}}</text>
      </view>
      <view wx:if="{{currentView === 'game' && !isFullscreen}}" class="action-btn fullscreen-btn" bindtap="toggleFullscreen">
        <text class="action-icon">⛶</text>
      </view>
      <view wx:if="{{isFullscreen}}" class="action-btn exit-fullscreen-btn" bindtap="toggleFullscreen">
        <text class="action-icon">⛶</text>
      </view>
    </view>
  </view>

  <!-- 主游戏区域 -->
  <view class="main-area">
    <!-- 游戏背景层 - 始终显示 -->
    <view class="game-background">
      <view class="scene-info-card" wx:if="{{currentView === 'game'}}">
        <text class="scene-location-text">{{currentScene}}</text>
      </view>

      <!-- 装饰层：树 -->
      <view class="game-decorations" wx:if="{{currentView === 'game'}}">
        <text class="deco-tree">🌲</text>
        <text class="deco-tree deco-tree-2">🌲</text>
        <text class="deco-tree deco-tree-3">🌲</text>
        <text class="deco-grass">🌿</text>
        <text class="deco-grass deco-grass-2">🌿</text>
        <text class="deco-flower">🌸</text>
      </view>

      <!-- 心宠精灵层（仅当在当前场景时显示） -->
      <view wx:if="{{currentView === 'game' && petSceneId === currentSceneId}}" class="pet-sprite" style="left: {{petSpriteX}}px; top: {{petSpriteY}}px;" animation="{{petAnimation}}">
        <view class="pet-body">
          <view class="pet-face">
            <view class="pet-eye pet-eye-left"></view>
            <view class="pet-eye pet-eye-right"></view>
            <view class="pet-blush pet-blush-left"></view>
            <view class="pet-blush pet-blush-right"></view>
            <view class="pet-mouth"></view>
          </view>
          <view class="pet-ear pet-ear-left">💕</view>
          <view class="pet-ear pet-ear-right">💕</view>
        </view>
        
        <!-- 主心宠对话气泡（特殊样式） -->
        <view wx:if="{{mainPetTalking}}" class="main-pet-dialog-bubble">
          <view class="main-pet-dialog-content">
            <text class="main-pet-dialog-text">{{mainPetDialogText}}</text>
          </view>
          <view class="main-pet-dialog-arrow"></view>
          <view class="main-pet-dialog-glow"></view>
        </view>
      </view>

      <!-- 其他心宠层（仅在同一场景时显示） -->
      <view wx:for="{{otherPets}}" wx:key="id" wx:for-item="otherPet" wx:if="{{currentView === 'game'}}">
        <view wx:if="{{otherPet.sceneId === currentSceneId}}" class="other-pet" style="left: {{otherPet.x}}px; top: {{otherPet.y}}px; transition: all 2s ease-in-out;">
          <view class="other-pet-body"></view>
          <view class="other-pet-name">{{otherPet.name}}</view>
          
          <!-- 对话气泡 -->
          <view wx:if="{{otherPet.isTalking}}" class="dialog-bubble {{otherPet.x > 200 ? 'dialog-left' : 'dialog-right'}}">
            <text class="dialog-text">{{otherPet.dialogText}}</text>
            <view class="dialog-arrow"></view>
          </view>
        </view>
      </view>

      <!-- 状态浮层 -->
      <view class="activity-overlay" wx:if="{{currentView === 'game'}}">
        <view class="activity-info">
          <block wx:if="{{petSceneId === currentSceneId}}">
            <view class="activity-main-text">
              <text class="activity-prefix">心宠正在 </text>
              <text class="activity-scene">{{petSceneName}}</text>
            </view>
            <text class="activity-subtext">{{petActivity}}</text>
          </block>
          <block wx:else>
            <view class="activity-main-text">
              <text class="activity-prefix">心宠正在 </text>
              <text class="activity-scene">{{petSceneName}}</text>
            </view>
            <text class="activity-subtext">{{petActivity}}</text>
          </block>
        </view>
        <view class="time-card">
          <text class="time-leaf left-leaf">🌿</text>
          <view class="time-content">
            <text class="time-text">{{currentTime}}</text>
            <text class="time-label">{{currentDateLabel}}</text>
          </view>
          <text class="time-leaf right-leaf">🌿</text>
        </view>
      </view>
    </view>

    <!-- ========== 世界地图视图 ========== -->
    <block wx:if="{{currentView === 'map'}}">
      <view class="view-content map-view {{isEditMode ? 'edit-mode' : ''}}">
        <!-- 世界地图背景 -->
        <image class="world-map-bg" src="/static/worldmap.png" mode="aspectFill"></image>
        
        <view class="map-scroll-content">
          <!-- 返回按钮和编辑按钮 -->
          <view class="map-actions-bar">
            <view wx:if="{{mapLevel === 'secondary' && !isEditMode}}" class="back-btn-secondary" bindtap="backToPrimary">
              ← 返回
            </view>
            <view class="edit-btn {{isEditMode ? 'active' : ''}}" bindtap="toggleEditMode">
              {{isEditMode ? '✓ 完成' : '✏️ 编辑'}}
            </view>
            <view wx:if="{{isEditMode}}" class="edit-btn export-btn" bindtap="exportSceneConfig">
              📋 导出
            </view>
          </view>

          <!-- 一级场景 -->
          <view class="territories primary-territories {{mapLevel === 'secondary' ? 'zoom-out' : 'zoom-in'}}">
            <!-- 一级地图心宠标记（仅在显示一级地图时可见） -->
            <view class="pet-marker-map pet-marker-primary" style="{{petMarkerPrimaryStyle}}">
              <view class="pet-marker-body">🎀</view>
              <view class="pet-marker-glow"></view>
            </view>
            <view
              class="territory transparent-territory {{item.current && currentSceneId === item.id ? 'current' : ''}} {{item.unlocked ? '' : 'locked'}} {{isEditMode ? 'editable' : ''}} {{editingSceneId === item.id ? 'dragging' : ''}}"
              wx:for="{{scenes}}"
              wx:key="id"
              style="left: {{item.x}}; top: {{item.y}};"
              data-scene="{{item}}"
              bindtap="{{isEditMode ? '' : 'onSceneTap'}}"
              bindtouchstart="onSceneTouchStart"
              bindtouchmove="onSceneTouchMove"
              bindtouchend="onSceneTouchEnd"
            >
              <view class="territory-body transparent-body" style="background: transparent;">
                <view class="terrain-texture" style="display: none;"></view>
                <view class="territory-icon" style="display: none;">{{item.icon}}</view>
                <view class="terrain-deco" wx:if="{{item.deco}}" style="display: none;">{{item.deco}}</view>
              </view>
              <view class="territory-sign" style="display: none;">
                <view class="sign-board">
                  <text class="sign-text">{{item.name}}</text>
                </view>
                <view class="sign-post"></view>
              </view>
              <view class="secondary-badge" wx:if="{{item.hasSecondary}}" style="display: none;">
                <text>🏠</text>
              </view>
              <view class="current-marker" wx:if="{{item.current && currentSceneId === item.id}}">
                <view class="marker-dot"></view>
                <view class="marker-pulse"></view>
              </view>
              <view class="lock-marker" wx:if="{{!item.unlocked}}" style="display: none;">
                <text>🔒</text>
              </view>
              <!-- 编辑模式显示坐标 -->
              <view wx:if="{{isEditMode}}" class="coord-label">
                {{item.x}}, {{item.y}}
              </view>
            </view>
          </view>

          <!-- 二级场景 -->
          <view wx:if="{{mapLevel === 'secondary'}}" class="territories secondary-territories zoom-in">
            <!-- 二级场景背景图 -->
            <image
              class="secondary-map-bg"
              src="/static/{{activePrimarySceneId}}.png"
              mode="scaleToFill"
              wx:if="{{activePrimarySceneId}}"
            ></image>
            <!-- 二级地图心宠标记（只有当心宠在当前查看的二级地图里时才显示） -->
            <view wx:if="{{petMarkerSecondaryStyle}}" class="pet-marker-map pet-marker-secondary" style="{{petMarkerSecondaryStyle}}">
              <view class="pet-marker-body">🎀</view>
              <view class="pet-marker-glow"></view>
            </view>
            <view
              class="territory transparent-territory {{currentSceneId === item.id ? 'current' : ''}} {{isEditMode ? 'editable' : ''}} {{editingSceneId === item.id ? 'dragging' : ''}}"
              wx:for="{{secondaryScenes[activePrimarySceneId]}}"
              wx:key="id"
              style="left: {{item.x}}; top: {{item.y}};"
              data-scene="{{item}}"
              bindtap="{{isEditMode ? '' : 'onSecondarySceneTap'}}"
              bindtouchstart="onSceneTouchStart"
              bindtouchmove="onSceneTouchMove"
              bindtouchend="onSceneTouchEnd"
            >
              <view class="territory-body transparent-body" style="background: transparent;">
                <view class="terrain-texture" style="display: none;"></view>
                <view class="territory-icon" style="display: none;">{{item.icon}}</view>
              </view>
              <view class="territory-sign" style="display: none;">
                <view class="sign-board">
                  <text class="sign-text">{{item.name}}</text>
                </view>
                <view class="sign-post"></view>
              </view>
              <view class="current-marker" wx:if="{{currentSceneId === item.id}}">
                <view class="marker-dot"></view>
                <view class="marker-pulse"></view>
              </view>
              <!-- 编辑模式显示坐标 -->
              <view wx:if="{{isEditMode}}" class="coord-label">
                {{item.x}}, {{item.y}}
              </view>
            </view>
          </view>

        </view>
      </view>
    </block>

    <!-- ========== 背包视图 ========== -->
    <block wx:if="{{currentView === 'bag'}}">
      <view class="view-header">
        <text class="view-title">心宠背包</text>
      </view>
      <!-- 容量条 -->
      <view class="capacity-bar">
        <view class="capacity-info">
          <text class="capacity-text">背包容量</text>
          <text class="capacity-value">{{bagCapacity.used}}/{{bagCapacity.total}}</text>
        </view>
        <view class="capacity-progress">
          <view class="capacity-fill" style="width: {{(bagCapacity.used / bagCapacity.total) * 100}}%"></view>
        </view>
      </view>
      <!-- 物品网格 -->
      <scroll-view class="view-content bag-view" scroll-y>
        <view wx:if="{{bagLoading}}" class="view-loading">
          <text>加载中...</text>
        </view>
        <view wx:elif="{{bagItems.length === 0}}" class="view-empty">
          <text class="empty-icon">🎒</text>
          <text class="empty-text">背包空空如也</text>
          <text class="empty-subtext">快去探索获得物品吧~</text>
        </view>
        <view wx:else class="bag-grid">
          <view
            class="bag-card"
            wx:for="{{bagItems}}"
            wx:key="itemId"
            data-item="{{item}}"
            bindtap="onBagItemTap"
          >
            <view class="bag-icon">{{item.icon}}</view>
            <view class="bag-name">{{item.name}}</view>
            <view class="bag-quantity">x{{item.quantity}}</view>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- ========== 日记视图 ========== -->
    <block wx:if="{{currentView === 'diary'}}">
      <view class="view-header">
        <text class="view-title">心情日记</text>
      </view>
      <!-- 选中日期的日记内容 -->
      <scroll-view class="view-content diary-view" scroll-y>
        <!-- 日历 -->
        <view class="calendar-container">
          <!-- 月份导航 -->
          <view class="calendar-header">
            <view class="calendar-nav-btn" bindtap="onPrevMonth">
              <text class="calendar-nav-icon">‹</text>
            </view>
            <text class="calendar-month">{{currentYear}}年{{currentMonth}}月</text>
            <view class="calendar-nav-btn" bindtap="onNextMonth">
              <text class="calendar-nav-icon">›</text>
            </view>
          </view>
          <!-- 星期标题 -->
          <view class="calendar-weekdays">
            <text wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}" wx:key="*this" class="calendar-weekday">{{item}}</text>
          </view>
          <!-- 日期网格 -->
          <view class="calendar-days">
            <view
              wx:for="{{calendarDays}}"
              wx:key="date"
              class="calendar-day {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.date === diarySelectedDate ? 'selected' : ''}} {{item.hasEntry ? 'has-entry' : ''}}"
              data-date="{{item.date}}"
              bindtap="onDiaryDateSelect"
            >
              <text class="calendar-day-num">{{item.day}}</text>
              <view wx:if="{{item.hasEntry}}" class="calendar-day-dot"></view>
            </view>
          </view>
        </view>
        <view class="diary-date-title">
          <text class="diary-date-text">{{selectedDateText}}</text>
          <text class="diary-date-weekday">{{selectedDateWeekday}}</text>
        </view>
        <view wx:if="{{diaryLoading}}" class="view-loading">
          <text>加载中...</text>
        </view>
        <view wx:elif="{{diaryEntries.length === 0}}" class="view-empty">
          <text class="empty-icon">📖</text>
          <text class="empty-text">这一天还没有记录</text>
          <text class="empty-subtext">点击其他日期查看心宠的故事~</text>
        </view>
        <view wx:else class="timeline">
          <view class="timeline-item" wx:for="{{diaryEntries}}" wx:key="id">
            <view class="timeline-left">
              <view class="timeline-dot" style="background-color: {{getDiaryTypeColor(item.type)}}"></view>
              <view wx:if="{{index !== diaryEntries.length - 1}}" class="timeline-line"></view>
            </view>
            <view class="timeline-content">
              <view class="timeline-time">{{item.time}}</view>
              <view class="timeline-card">
                <view class="timeline-badge" style="background-color: {{getDiaryTypeColor(item.type)}}20; color: {{getDiaryTypeColor(item.type)}}">
                  {{getDiaryTypeLabel(item.type)}}
                </view>
                <view class="timeline-text">{{item.content}}</view>
                <view class="timeline-stats">
                  <view class="stat-change" wx:if="{{item.moodAfter !== item.moodBefore}}">
                    <text class="stat-label">心情</text>
                    <text class="stat-value {{item.moodAfter > item.moodBefore ? 'positive' : 'negative'}}">
                      {{item.moodAfter > item.moodBefore ? '+' : ''}}{{item.moodAfter - item.moodBefore}}
                    </text>
                  </view>
                  <view class="stat-change" wx:if="{{item.energyAfter !== item.energyBefore}}">
                    <text class="stat-label">能量</text>
                    <text class="stat-value {{item.energyAfter > item.energyBefore ? 'positive' : 'negative'}}">
                      {{item.energyAfter > item.energyBefore ? '+' : ''}}{{item.energyAfter - item.energyBefore}}
                    </text>
                  </view>
                  <view class="stat-change" wx:if="{{item.socialAfter !== item.socialBefore}}">
                    <text class="stat-label">社交</text>
                    <text class="stat-value {{item.socialAfter > item.socialBefore ? 'positive' : 'negative'}}">
                      {{item.socialAfter > item.socialBefore ? '+' : ''}}{{item.socialAfter - item.socialBefore}}
                    </text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- ========== 帮助视图 ========== -->
    <block wx:if="{{currentView === 'help'}}">
      <view class="view-header">
        <text class="view-title">{{hasEvent ? '需要帮助' : '暂无求助'}}</text>
      </view>
      <scroll-view class="view-content help-view" scroll-y>
        <view wx:if="{{helpLoading}}" class="view-loading">
          <text>加载中...</text>
        </view>
        <view wx:elif="{{!hasEvent || helpEvents.length === 0}}" class="view-empty">
          <text class="empty-icon">🌟</text>
          <text class="empty-text">暂无求助事件</text>
          <text class="empty-subtext">心宠一切安好，继续保持关注哦~</text>
        </view>
        <view wx:else class="event-list">
          <view
            class="event-card {{item.status === 'resolved' ? 'resolved' : ''}}"
            wx:for="{{helpEvents}}"
            wx:key="id"
          >
            <view class="event-header">
              <text class="event-type">{{item.type === 'large' ? '大型事件' : '日常事件'}}</text>
              <text class="event-status {{item.status}}">{{item.status === 'pending' ? '待处理' : '已解决'}}</text>
            </view>

            <view class="event-title">{{item.title}}</view>
            <view class="event-desc">{{item.description}}</view>

            <!-- 选项列表 -->
            <view wx:if="{{item.status === 'pending'}}" class="options-list">
              <view
                class="option-item"
                wx:for="{{item.options}}"
                wx:for-item="option"
                wx:key="id"
                data-event-id="{{item.id}}"
                data-option-id="{{option.id}}"
                bindtap="onHelpOptionSelect"
              >
                <text class="option-text">{{option.text}}</text>
                <text class="option-hint">{{option.hint}}</text>
                <view class="option-impact">
                  <text wx:if="{{option.impact.mood}}">心情{{option.impact.mood > 0 ? '+' : ''}}{{option.impact.mood}}</text>
                  <text wx:if="{{option.impact.energy}}">能量{{option.impact.energy > 0 ? '+' : ''}}{{option.impact.energy}}</text>
                  <text wx:if="{{option.impact.sociability}}">社交{{option.impact.sociability > 0 ? '+' : ''}}{{option.impact.sociability}}</text>
                </view>
              </view>
            </view>

            <!-- 已解决显示结果 -->
            <view wx:if="{{item.status === 'resolved'}}" class="resolved-info">
              <text>已选择：{{item.resolvedOptionText}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

  </view>

  <!-- 按钮面板 - 悬浮在游戏区域上方 -->
  <view class="button-panel" style="bottom: {{isFullscreen ? '10rpx' : '80rpx'}};">
    <image class="button-panel-bg" src="/static/b1.png" mode="scaleToFill"></image>
    <view class="btn-item {{currentView === 'map' ? 'active' : ''}}" bindtap="onMapTap">
      <view class="btn-icon">🗺️</view>
      <text class="btn-label">世界地图</text>
    </view>
    <view class="btn-item {{currentView === 'help' ? 'active' : ''}} {{hasEvent ? 'has-event' : ''}}" bindtap="onHelpTap">
      <view class="btn-icon">🤝</view>
      <text class="btn-label">{{hasEvent ? '需要帮助' : '暂无求助'}}</text>
      <view wx:if="{{hasEvent}}" class="event-badge">{{eventCount}}</view>
    </view>
    <view class="btn-item {{currentView === 'bag' ? 'active' : ''}}" bindtap="onBagTap">
      <view class="btn-icon">🎒</view>
      <text class="btn-label">心宠背包</text>
    </view>
    <view class="btn-item {{currentView === 'diary' ? 'active' : ''}}" bindtap="onDiaryTap">
      <view class="btn-icon">📖</view>
      <text class="btn-label">心情日记</text>
    </view>
  </view>

  <!-- 场景详情弹窗（世界地图用） -->
  <view class="scene-modal {{showSceneModal ? 'show' : ''}}" wx:if="{{showSceneModal}}">
    <view class="modal-mask" bindtap="closeSceneModal"></view>
    <view class="modal-content">
      <view class="modal-header" style="background: {{selectedScene.gradient}};">
        <view class="modal-icon">{{selectedScene.icon}}</view>
        <text class="modal-title">{{selectedScene.name}}</text>
      </view>
      <view class="modal-body">
        <text class="modal-desc">{{selectedScene.description}}</text>
        <view class="modal-tags">
          <view class="modal-tag" wx:for="{{selectedScene.tags}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeSceneModal">取消</view>
        <view class="modal-btn confirm {{selectedScene.unlocked ? '' : 'disabled'}}" bindtap="confirmEnterScene">
          {{selectedScene.current ? '当前场景' : (selectedScene.unlocked ? '进入场景' : '未解锁')}}
        </view>
      </view>
    </view>
  </view>
</view>