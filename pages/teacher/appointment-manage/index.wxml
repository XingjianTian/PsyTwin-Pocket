<t-navbar title="预约管理" left-arrow />

<view class="appointment-manage-page">
  <!-- 日期选择 -->
  <view class="date-selector" bindtap="onDateSelect">
    <text class="selected-date">{{selectedDate}}</text>
    <t-icon name="calendar" size="32rpx" color="#666" />
  </view>

  <!-- Tab筛选 -->
  <view class="tabs-wrapper">
    <t-tabs value="{{activeTab}}" bind:change="onTabChange">
      <t-tab-panel wx:for="{{tabs}}" wx:key="key" label="{{item.label}}" value="{{item.key}}" />
    </t-tabs>
  </view>

  <!-- 预约列表 -->
  <scroll-view class="appointment-list" scroll-y>
    <view
      class="appointment-item {{item.status}}"
      wx:for="{{appointmentList}}"
      wx:key="id"
      data-item="{{item}}"
      bindtap="onAppointmentTap"
    >
      <view class="appointment-header">
        <image class="student-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="appointment-info">
          <text class="student-name">{{item.studentName}}</text>
          <text class="student-id">{{item.studentId}}</text>
        </view>
        <t-tag
          wx:if="{{item.type === 'counseling'}}"
          theme="primary"
          size="small"
        >心理咨询</t-tag>
        <t-tag
          wx:if="{{item.type === 'vr'}}"
          theme="warning"
          size="small"
        >VR体验</t-tag>
        <t-tag
          wx:if="{{item.type === 'group'}}"
          theme="success"
          size="small"
        >团体活动</t-tag>
      </view>

      <view class="appointment-time">
        <view class="time-row">
          <t-icon name="time" size="28rpx" color="#666" />
          <text class="time-text">{{item.date}} {{item.time}} - {{item.endTime}}</text>
        </view>
        <view class="location-row">
          <t-icon name="location" size="28rpx" color="#666" />
          <text class="location-text">{{item.location}}</text>
        </view>
      </view>

      <view wx:if="{{item.reason}}" class="appointment-reason">
        <text class="reason-label">预约事由:</text>
        <text class="reason-content">{{item.reason}}</text>
      </view>

      <view wx:if="{{item.cancelReason}}" class="cancel-reason">
        <t-icon name="info-circle" size="24rpx" color="#ff4d4f" />
        <text>取消原因: {{item.cancelReason}}</text>
      </view>

      <!-- 待确认状态的操作按钮 -->
      <view wx:if="{{item.status === 'pending'}}" class="appointment-actions">
        <t-button
          theme="light"
          size="small"
          shape="round"
          data-id="{{item.id}}"
          catchtap="onRejectTap"
        >拒绝</t-button>
        <t-button
          theme="primary"
          size="small"
          shape="round"
          data-id="{{item.id}}"
          catchtap="onConfirmTap"
        >确认</t-button>
      </view>
    </view>

    <!-- 空状态 -->
    <t-empty
      wx:if="{{appointmentList.length === 0 && !loading}}"
      icon="calendar"
      description="暂无{{activeTab === 'pending' ? '待确认' : activeTab === 'confirmed' ? '已确认' : activeTab === 'completed' ? '已完成' : '已取消'}}的预约"
    />

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <t-icon name="loading" size="40rpx" />
      <text>加载中...</text>
    </view>
  </scroll-view>

  <!-- 日历选择器 -->
  <t-calendar
    visible="{{showCalendar}}"
    value="{{selectedDate}}"
    bind:confirm="onCalendarConfirm"
    bind:close="onCalendarClose"
  />
</view>
